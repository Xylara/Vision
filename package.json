{
  "name": "discord-gif-bot",
  "version": "1.0.0",
  "description": "Discord bot with a /gif slash command that converts images to animated GIFs and uploads them to S3-compatible object storage (Cloudflare R2, Backblaze B2, ...)",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "deploy": "node src/deploy-commands.js",
    "test:convert": "node scripts/test-convert.js"
  },
  "keywords": [
    "discord",
    "discord.js",
    "gif",
    "r2",
    "backblaze",
    "s3"
  ],
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "gifenc": "^1.0.3",
    "sharp": "^0.33.5",
    "zod": "^3.24.1"
  }
}
