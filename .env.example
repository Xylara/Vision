# ---------------------------------------------------------------------------
# Discord
# https://discord.com/developers/applications -> your app -> Bot / General
# ---------------------------------------------------------------------------
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=000000000000000000

# Optional: register /gif in one server instantly. Leave empty for global
# commands (can take up to an hour to appear).
DISCORD_GUILD_ID=

# Register slash commands automatically every time the bot starts.
AUTO_DEPLOY_COMMANDS=true

# ---------------------------------------------------------------------------
# Object storage (S3 compatible)
# Pick one provider block below and delete/ignore the other.
# ---------------------------------------------------------------------------

# ---- Cloudflare R2 --------------------------------------------------------
STORAGE_PROVIDER=r2
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com   # optional, built from CLOUDFLARE_ACCOUNT_ID
STORAGE_REGION=auto
STORAGE_BUCKET=gifs
STORAGE_ACCESS_KEY_ID=your-r2-access-key-id
STORAGE_SECRET_ACCESS_KEY=your-r2-secret-access-key

# ---- Backblaze B2 (uncomment and remove the R2 values above) --------------
# STORAGE_PROVIDER=b2
# B2_REGION=us-west-004
# STORAGE_ENDPOINT=https://s3.us-west-004.backblazeb2.com          # optional, built from B2_REGION
# STORAGE_REGION=us-west-004
# STORAGE_BUCKET=my-gif-bucket
# STORAGE_ACCESS_KEY_ID=your-b2-key-id
# STORAGE_SECRET_ACCESS_KEY=your-b2-application-key

# ---- Shared storage settings ---------------------------------------------
# Public base URL (custom domain, r2.dev, or B2 friendly URL).
# Leave empty to hand out presigned URLs instead.
STORAGE_PUBLIC_BASE_URL=
# Folder prefix inside the bucket. Keys look like gifs/2026/10/<uuid>.gif
STORAGE_KEY_PREFIX=gifs
# Presigned link lifetime in seconds (max 604800 = 7 days).
STORAGE_SIGNED_URL_TTL=604800
# Only needed for providers that require path-style addressing (some MinIO setups).
STORAGE_FORCE_PATH_STYLE=false

# ---------------------------------------------------------------------------
# GIF rendering
# ---------------------------------------------------------------------------
GIF_MAX_WIDTH=480
GIF_FRAMES=24
GIF_FRAME_DELAY_MS=60
# Zoom strength of the animation, 0 disables it (static GIF).
GIF_ZOOM=0.12
# Transparent images are flattened onto this color (quote it: dotenv treats a
# leading # as a comment).
GIF_BACKGROUND="#ffffff"

# ---------------------------------------------------------------------------
# Limits and behaviour
# ---------------------------------------------------------------------------
MAX_INPUT_MB=12
MAX_OUTPUT_MB=8
COOLDOWN_SECONDS=5
# auto = attach the GIF only when the bucket is private; always | never
REPLY_WITH_ATTACHMENT=auto

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
